# Only the game itself needs to ship. Keep the deploy lean & fast.
.git
.vercel
.playwright-mcp
.agents
docs
# document archive (iPad attachments) lives in git only, never deploys
archive
# modelgen dev surface — the game only needs models/*/spec.json at runtime
tools
tests
models/*/renders
models/*/BUILD.md
# Runtime audio assets must deploy; otherwise browsers fall back to generated synth sounds.
README.md

# Full-res source model (the game loads the committed ~18 MB GLB)
*.orig.glb

# Dev / QA screenshots & captures (root)
shot-*.jpeg
tank-*.jpeg
rig-*.jpeg
barrel*.jpeg
bolts-check.jpeg
glb-iso.jpeg
probe-height.jpeg
shop-thumb.png
shop-verify.jpeg
ph4-held-medkit.png

# Standalone dev model viewers
glb-rig.html
glb-viewer.html
tank-viewer.html
tankglb-test.html

# Unused / reference-only dev assets
assets/Terrifying SU-57 Sound*.mp3
assets/arty*.mov
assets/ref-t90m-blueprint.png

# stray empty file
game

# buildgen: per-building verification artefacts stay out of the deploy bundle
buildings/*/renders
buildings/*/BUILD.md
